# Database
DATABASE_URL=postgresql://orionsfrontier:change-this-local-password@localhost:5432/orionsfrontier
POSTGRES_USER=orionsfrontier
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=orionsfrontier
POSTGRES_PORT=5432

# API
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Required in production (16+ characters); development falls back to a public seed.
# WORLD_SEED=
# Behind a reverse proxy: true, the number of proxy hops, or a comma list of proxy IPs/CIDRs.
# Off by default, so clients cannot fake their address (rate limits use it).
# TRUST_PROXY=

# Admin account with a station, applied on every API start. Set both or neither (12+ characters).
ADMIN_EMAIL=admin@web.dev
ADMIN_PASSWORD=change-this-admin-password

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# Auth
JWT_SECRET=change-this-in-production-to-a-secure-random-string
