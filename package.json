{
  "name": "orions-frontier",
  "version": "0.1.0",
  "private": true,
  "description": "A persistent idle world in space",
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "build:packages": "tsc -b packages/shared packages/game-config",
    "build": "npm run build:packages && npm run build --workspace @orions-frontier/api && npm run build --workspace @orions-frontier/frontend",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test:unit": "npm run build:packages && npm run test:unit --workspaces --if-present",
    "test:integration": "docker compose run --build --rm --remove-orphans api npm run test:integration --workspaces --if-present",
    "test:behavior": "npm run test:integration",
    "test:playtest-bootstrap": "node scripts/test-playtest-bootstrap.mjs",
    "test:playtest-population": "npm run playtest -- --population-smoke --seed population-smoke --start 2030-01-01T00:00:00.000Z",
    "test:playtest-runner": "node scripts/test-playtest-runner.mjs",
    "test:playtest-e2e": "node scripts/test-playtest-e2e.mjs",
    "verify": "npm run check && npm run build && npm run test:unit && npm run test:integration && npm run test:playtest-e2e",
    "clean": "npm run clean --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @orions-frontier/api",
    "scanner:report": "npm run scanner:report --workspace @orions-frontier/api",
    "world:report": "npm run world:report --workspace @orions-frontier/api",
    "playtest": "node scripts/run-playtest.mjs",
    "playtest:smoke": "npm run playtest -- --seed smoke --duration-hours 2 --step-seconds 60 --join-interval-minutes 60 --population-limit 2 --snapshot-interval-minutes 30",
    "playtest:baseline": "node scripts/run-playtest-baseline.mjs",
    "docker:rebuild": "docker compose up -d --build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vue-eslint-parser": "^10.4.0"
  }
}
