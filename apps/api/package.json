{
  "name": "@orions-frontier/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../packages/shared/dist --include ../../packages/game-config/dist src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "world:report": "node --import tsx src/tools/world-report.ts"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@orions-frontier/game-config": "^0.1.0",
    "@orions-frontier/shared": "^0.1.0",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.9.9",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
