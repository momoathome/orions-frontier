{
  "name": "@orions-frontier/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/env": "^4.3.0",
    "@fastify/helmet": "^11.1.1",
    "@orions-frontier/game-config": "workspace:*",
    "@orions-frontier/shared": "workspace:*",
    "@orions-frontier/types": "workspace:*",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.27.0",
    "postgres": "^3.4.4",
    "redis": "^4.6.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "drizzle-kit": "^0.21.2",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
