# Lives as .env next to compose.prod.yaml on the server (chmod 600). deploy.sh maintains IMAGE_TAG.
DOMAIN=play.example.com
POSTGRES_USER=orionsfrontier
POSTGRES_DB=orionsfrontier
IMAGE_TAG=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Fixes the map for good. Keep a copy off the server: a new value does not fit the existing world.
WORLD_SEED=

# Optional, set both or neither. Applied on every API start, also after a change here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
